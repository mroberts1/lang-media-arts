.DS_Store
public/
.chum-cache/

# Local Obsidian app state. Contains plugin credentials and large binaries;
# the site build does not need it.
.obsidian/

# Smart Connections plugin embeddings cache.
.smart-env/

.quartz/node_modules/
.quartz/.quartz-cache/
.quartz/.quartz/
.quartz/plugins/

# Editor state. Local settings and appearance, not site content; the same
# reasoning that keeps .obsidian/ out.
.cursor/
.vscode/

# Canvas push artifacts. Regenerated by script/canvas on every run, the same
# way public/ is by the build; canvas.json (the course config) is tracked.
canvas-*.html
